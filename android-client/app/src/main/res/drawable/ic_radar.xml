<?xml version="1.0" encoding="utf-8"?>
<!-- Crosshair/radar icon matching the desktop app SVG -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="30"
    android:viewportHeight="30">

    <!-- Outer ring -->
    <path
        android:pathData="M2,15 A13,13,0,0,1,28,15 A13,13,0,0,1,2,15"
        android:fillColor="#00000000"
        android:strokeColor="#48b9ff"
        android:strokeWidth="2" />

    <!-- Center dot -->
    <path
        android:pathData="M9,15 A6,6,0,0,1,21,15 A6,6,0,0,1,9,15"
        android:fillColor="#D948b9ff" />

    <!-- Top tick -->
    <path
        android:pathData="M15,2 L15,8"
        android:strokeColor="#48b9ff"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Bottom tick -->
    <path
        android:pathData="M15,22 L15,28"
        android:strokeColor="#48b9ff"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Left tick -->
    <path
        android:pathData="M2,15 L8,15"
        android:strokeColor="#48b9ff"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Right tick -->
    <path
        android:pathData="M22,15 L28,15"
        android:strokeColor="#48b9ff"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

</vector>
