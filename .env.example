# SentinelMDM server configuration.
#
# Copy to `.env` for local development, or supply these as environment variables in
# your deployment. In Docker Swarm, `readSecret()` in server/config.js checks
# /run/secrets/<name> first and falls back to the environment variable here.
#
# NEVER commit a filled-in copy of this file.

# ── Core ───────────────────────────────────────────────────────────────────────
PORT=3000
ROLE=standalone                 # standalone | web | worker
SERVER_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
TRACKER_DOMAIN=localhost:3000   # host used in outgoing email links
DEVICE_HOST=                    # optional: redirect the web UI away from this host

# SQLite by default. Set DATABASE_URL for Postgres/HA.
DB_PATH=./tracker.db
# DATABASE_URL=postgres://user:password@host:5432/sentinel

# ── Bootstrap administrator ──────────────────────────────────────────────────
# The server refuses to start if no admin password is supplied.
ADMIN_USER=admin
ADMIN_PASS=                     # required; use a long random value

# ── Session / encryption secrets ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ENC_PASSPHRASE=
SERVER_ENC_KEY_PEM=
HWID_KEY=
TOTP_SECRET=

# ── Redis (optional; required for multi-replica Socket.IO) ───────────────────
REDIS_URL=
REDIS_SENTINELS=
REDIS_MASTER_NAME=

# ── Object storage (Cloudflare R2 / any S3-compatible endpoint) ──────────────
R2_ENDPOINT=
R2_BUCKET=sentinelmdm
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

OTA_R2_ENDPOINT=
OTA_R2_BUCKET=sentinelmdm-ota
OTA_ACCESS_KEY_ID=
OTA_SECRET_ACCESS_KEY=
OTA_PUBLIC_URL=                 # public base URL that serves OTA/ISO files

# ── Tailscale integration (optional) ─────────────────────────────────────────
TS_TAILNET=
# Tailscale OAuth client secret (tskey-client-...); prefer the Docker secret
# `sentinel_ts_api_token` over putting it here.
TS_API_TOKEN=

# ── Remote-assist transport (optional) ──────────────────────────────────────
XRAY_VPN_UUID=
XRAY_TAILNET_UUID=
XRAY_REMOTEASSIST_UUID=
APK_UPDATE_PIN=

# ── Deployment-specific app association ─────────────────────────────────────
# Optional spoken geofence TTS allow-list (comma-separated device IDs).
GEOFENCE_TTS_DEVICE_IDS=
# Android App Links / passkey association: SHA-256 of the client signing cert,
# colon-separated as Android prints it (e.g. AA:BB:...). Empty omits the entry.
ASSETLINKS_CLIENT_CERT=
# JSON map of APK signing-cert SHA-256 -> variant name, e.g. {"<sha256>":"stock"}.
APK_SIGNER_MAP=

# ── Remote-assist / bastion integration ──────────────────────────────────────
BASTION_INTERNAL_URL=
BASTION_INTERNAL_KEY=
