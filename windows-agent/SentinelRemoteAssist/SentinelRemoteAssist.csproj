    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 2.1.2: Brotli-compresses managed assemblies and native libs in the single-file bundle
         (~50-60 % on managed code). Historically disabled because GetManifestResourceNames()
         broke resource enumeration in compressed bundles — all extraction sites now use
         hardcoded assembly-qualified resource names (xray.exe.gz, rclone.exe.gz, the two
         .ps1.gz scripts) and never call GetManifestResourceNames(). Smoke-tested on the
         builder's Linux SDK 8.0.422 (GetManifestResourceStream works); spot-check on a real
         Windows box before trusting. -->
    <!-- 2.1.3: two changes: (1) ToS dialog removed from auto-provisioning flow. The installer
         goes straight to elevated cutover + enrollment with no user prompt (ToS consent is
         auto-recorded server-side). (2) New SilentInstaller.cs for fully headless
         install/uninstall/status entry points (silent-install, silent-uninstall, silent-status)
         for scripted deployment (SCCM, Intune, bastion provisioning pipeline). No UI, no ToS,
         no UAC dialog. Must run elevated (admin or SYSTEM). silent-install takes an optional
         enrollment ticket argument. silent-status reports install state to stdout. Exit codes:
         0=success, 1=generic failure, 2=not elevated, 3=already installed, 4=setup failed. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Account-linked login build variant, mirroring the Android agent's -PadminAgent Gradle flag
         (BuildConfig.ADMIN_AGENT) — see Config.AdminAgent's doc comment. false (default) = public
         build, email+password, posts to /login. true = admin/sub-user build, username+password,
         posts to /api/device-admin/login. Build with: dotnet publish -p:AdminAgent=true
         Does NOT affect the legacy ad hoc (SessionEmbedded-baked, no login) build path at all. -->
    <AdminAgent Condition="'$(AdminAgent)'==''">false</AdminAgent>
    <DefineConstants Condition="'$(AdminAgent)'=='true'">$(DefineConstants);ADMIN_AGENT</DefineConstants>
    <!-- Auto-provisioning installer variant (2.0.3): per-account exe with enrollment ticket +
         server URL + ToS version baked in (AutoProvisionEmbedded.cs, generated by bastion-builder's
         /build-installer). First run: ToS/MSA dialog -> elevated install w/ persistence ->
         ticket enrollment (no login on the target PC). See AutoProvisionFlow.cs. -->
    <AutoProvisionBuild Condition="'$(AutoProvisionBuild)'==''">false</AutoProvisionBuild>
    <DefineConstants Condition="'$(AutoProvisionBuild)'=='true'">$(DefineConstants);AUTOPROVISION_BUILD</DefineConstants>
    <!-- Set by bastion-builder's build_account_linked_exe() for BOTH variants (public and admin) —
         distinguishes "a real account-linked build" from a template/dev build now that no
         account-specific material is embedded at build time (Hop-1 identity is generated per-device
         at runtime instead — see Hop1Identity.cs). Build with: dotnet publish -p:AccountLinkedBuild=true -->
    <AccountLinkedBuild Condition="'$(AccountLinkedBuild)'==''">false</AccountLinkedBuild>
    <DefineConstants Condition="'$(AccountLinkedBuild)'=='true'">$(DefineConstants);ACCOUNT_LINKED_BUILD</DefineConstants>
    <!-- Two distinct output filenames from one source tree, same convention as the Android APKs
         (SentinelMDM-<ver>.apk vs SentinelMDM-Admin-<ver>.apk) — never swap which is which; verify
         by which login endpoint a build's Config.AdminAgent constant resolves to, not the filename
         alone, if in doubt. -->
    <AssemblyName Condition="'$(AdminAgent)'=='true'">Sentinel-Admin</AssemblyName>
  </PropertyGroup>

  <!-- GZip-compress PowerShell scripts before embedding so they're opaque in the binary.
       ⚠️ 2.0.7 — DELIBERATELY NOT incremental. This target used to carry
         Inputs="sentinel-setup.ps1;sentinel-uninstall.ps1"
         Outputs="sentinel-setup.ps1.gz;sentinel-uninstall.ps1.gz"
       so MSBuild skipped it whenever the .gz was not older than the .ps1. The .gz is a
       CHECKED-IN artifact and the builder image copies both in via `COPY SentinelRemoteAssist/`,
       which does not preserve the relative mtime ordering from the working tree — so inside the
       image the outputs never looked stale, the target was skipped, and the build embedded the
       PREVIOUS release's script while happily compiling the current C#.
       Live consequence (2.0.6, found 2026-08-03): the C# half of the Hop-2 key fix shipped and
       worked (the agent logged "(1 pending)"/"(2 pending)" exactly as intended) while the
       sentinel-setup.ps1 half — the part that actually splits and INSTALLS those keys — was the
       old copy, so administrators_authorized_keys still never changed and connect.sh still failed
       with "Permission denied (publickey)". A build that silently mixes new code with an old
       embedded script is far worse than re-gzipping two small files on every build, which costs
       milliseconds. Keep this unconditional. -->
  <Target Name="CompressScripts" BeforeTargets="BeforeBuild;BeforePublish">
    <Exec Command="gzip -c &quot;$(ProjectDir)sentinel-setup.ps1&quot; &gt; &quot;$(ProjectDir)sentinel-setup.ps1.gz&quot;" />
    <Exec Command="gzip -c &quot;$(ProjectDir)sentinel-uninstall.ps1&quot; &gt; &quot;$(ProjectDir)sentinel-uninstall.ps1.gz&quot;" />
  </Target>

  <!-- GZip-compress the big embedded native binaries before embedding (2.1.2): xray.exe
       35.6 MB -> ~13 MB, rclone.exe 78.8 MB -> ~27 MB — ~74 MB off the single-file exe.
       Pre-compressing large opaque binaries is still worthwhile even with
       EnableCompressionInSingleFile=true (Brotli on pre-compressed data stays tight).
       Both extraction sites (XrayTransportManager.TryExtractXray, S3DriveManager.TryExtractRclone)
       decompress on first run, so the on-disk exes are byte-identical to an uncompressed build.
       DELIBERATELY NOT incremental, same rationale as CompressScripts: the builder image's
       `COPY SentinelRemoteAssist/` does not preserve working-tree mtimes, so a stale .gz would
       otherwise be silently re-embedded alongside fresh C#. Unconditional re-gzip is ~2s. -->
  <Target Name="CompressNativeBinaries" BeforeTargets="BeforeBuild;BeforePublish">
    <Exec Command="gzip -9 -c &quot;$(ProjectDir)xray.exe&quot; &gt; &quot;$(ProjectDir)xray.exe.gz&quot;" Condition="Exists('$(ProjectDir)xray.exe')" />
    <Exec Command="gzip -9 -c &quot;$(ProjectDir)rclone.exe&quot; &gt; &quot;$(ProjectDir)rclone.exe.gz&quot;" Condition="Exists('$(ProjectDir)rclone.exe')" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="OpenSSH-Win64.zip" Condition="Exists('OpenSSH-Win64.zip')" />
    <EmbeddedResource Include="sentinel-setup.ps1.gz" />
    <EmbeddedResource Include="sentinel-uninstall.ps1.gz" />
    <!-- XrayTransportManager.cs's xray-core client binary, gzip-embedded (CompressNativeBinaries
         generates xray.exe.gz from the checked-in xray.exe every build). Conditional so the build
         doesn't break before the binary is added; once present, extraction/Start() picks it up
         automatically. -->
    <EmbeddedResource Include="xray.exe.gz" Condition="Exists('xray.exe.gz')" />
    <!-- S3DriveManager.cs's rclone binary (windows/amd64), gzip-embedded — same pattern and
         conditional-include as xray.exe.gz above. -->
    <EmbeddedResource Include="rclone.exe.gz" Condition="Exists('rclone.exe.gz')" />
  </ItemGroup>

  <ItemGroup>
    <!-- EventLogReader/EventLogWatcher (System.Diagnostics.Eventing.Reader) for
         AppControlWatcher.cs — not in the base net8.0-windows BCL, needs this package explicitly. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
    <!-- RemoteAssistSocket.cs — Socket.IO v4-protocol client for the SentinelMDM control channel
         (register/heartbeat/status + server pushes). Verified against the server's socket.io@4.x
         handshake in RemoteAssistSocket's own doc comment. -->
    <PackageReference Include="SocketIOClient" Version="3.1.2" />
    <!-- AiChatForm.cs/ConsentDialog.cs/MainForm.cs — icons and other System.Drawing UI usage. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
