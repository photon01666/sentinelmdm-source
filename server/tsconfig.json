{
  // Phase-0 TypeScript scaffold — CHECKER ONLY. Nothing is emitted; `node server.js`
  // keeps running the exact same files. `npm run typecheck` runs tsc as a strict linter.
  //
  // checkJs is OFF globally on purpose: opt files in one at a time with a `// @ts-check`
  // comment at the top (start with db.js, redis.js, webauthn.js — the small shared
  // modules — then server.js last). Flipping checkJs:true here would surface thousands
  // of errors from the 11k-line server.js at once.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules", "public", "migrations", "shim-spike.js", "webui.d.ts"]
}
