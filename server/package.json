{
  "name": "sentinelmdm-server",
  "version": "1.0.3",
  "description": "Self-hosted device-management server for SentinelMDM",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.webui.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:webui": "tsc -p tsconfig.webui.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@simplewebauthn/server": "^13.3.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "connect-redis": "^7.1.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^8.0.10",
    "pg-promise": "^11.10.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.6.1",
    "speakeasy": "^2.0.0",
    "stripe": "^22.2.0",
    "undici": "^6.27.0",
    "web-push": "^3.6.7",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^6.0.3"
  },
  "license": "AGPL-3.0-only",
  "private": true
